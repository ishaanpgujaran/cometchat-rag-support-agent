# Required — obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.7-flash
# Comma-separated list of free-tier models for evaluation rotation.
# The eval suite distributes 25 cases across these models to stay within the 20 RPD limit per model.
# Add a third model if you need to re-run the suite on the same day.
GEMINI_EVAL_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional path overrides (defaults resolve relative to the project root)
# KNOWLEDGE_BASE_DIR=knowledge-base
# ORDERS_FILE_PATH=data/orders.json
